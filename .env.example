ENVIRONMENT=development
LLM_PROVIDER=gemini
AGENT_RUNTIME=strands
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_DELAY_SECONDS=1
DATABASE_PROVIDER=sqlite
SQLITE_DB_PATH=heatops_dev.db
AUTHORIZATION_PROVIDER=cedar
AUTHENTICATION_PROVIDER=demo
SEED_DEMO_DATA=true
CEDAR_POLICY_PATH=
NOTIFICATION_PROVIDER=console
AWS_REGION=us-east-1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AWS production deployment values are injected by infrastructure/deploy-aws.sh.
# The default local configuration does not initialize AWS clients.
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# DYNAMODB_WARDS_TABLE=heatops_wards
# DYNAMODB_VULNERABILITIES_TABLE=heatops_vulnerabilities
# DYNAMODB_RESOURCES_TABLE=heatops_resources
# DYNAMODB_EVENTS_TABLE=heatops_events
# DYNAMODB_ACTION_PLANS_TABLE=heatops_action_plans
# DYNAMODB_TASKS_TABLE=heatops_tasks
# DYNAMODB_ESCALATIONS_TABLE=heatops_escalations

# Optional local SNS-compatible notifications through LocalStack.
# Start LocalStack with its SNS service enabled before selecting this provider.
# NOTIFICATION_PROVIDER=localstack_sns
LOCALSTACK_ENDPOINT_URL=http://localhost:4566
LOCALSTACK_SNS_TOPIC_NAME=heatops-notifications

# For real AWS SNS only:
# NOTIFICATION_PROVIDER=sns
# SNS_TOPIC_ARN=

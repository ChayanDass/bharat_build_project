ENVIRONMENT=development
LLM_PROVIDER=gemini
GEMINI_API_KEY=
DATABASE_PROVIDER=sqlite
SQLITE_DB_PATH=heatops_dev.db
AUTHORIZATION_PROVIDER=cedar
CEDAR_POLICY_PATH=
NOTIFICATION_PROVIDER=console
AWS_REGION=us-east-1

# Optional local SNS-compatible notifications through LocalStack.
# Start LocalStack with its SNS service enabled before selecting this provider.
# NOTIFICATION_PROVIDER=localstack_sns
LOCALSTACK_ENDPOINT_URL=http://localhost:4566
LOCALSTACK_SNS_TOPIC_NAME=heatops-notifications

# For real AWS SNS only:
# NOTIFICATION_PROVIDER=sns
# SNS_TOPIC_ARN=
